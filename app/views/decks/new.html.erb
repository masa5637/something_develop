<div class="pg">
  <div class="topbar">
    <a href="/" class="topbar-logo">ARCANA</a>
  </div>

  <div class="form-area">
    <div class="lobby-title">デッキを作成</div>

    <%= form_with model: @deck, local: true do |f| %>
      <div class="card-form">
        <div class="field">
          <label>デッキ名</label>
          <%= f.text_field :name, placeholder: "例: 炎の軍勢" %>
        </div>
        <%= f.submit "作成する", class: "btn-main" %>
      </div>
    <% end %>

    <%= link_to "← 戻る", decks_path, class: "back-btn" %>
  </div>
</div>