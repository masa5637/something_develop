<div class="pg">
  <div class="topbar">
    <a href="/" class="topbar-logo">ARCANA</a>
  </div>

  <div class="form-area">
    <div class="lobby-title">カードを編集</div>

    <%= form_with model: @card, local: true do |f| %>
      <div class="card-form">
        <div class="field">
          <label>カード名</label>
          <%= f.text_field :name %>
        </div>

        <div class="field">
          <label>攻撃力 (ATK)</label>
          <%= f.number_field :attack %>
        </div>

        <div class="field">
          <label>防御力 (DEF)</label>
          <%= f.number_field :defense %>
        </div>

        <% if @card.image.attached? %>
          <div class="field">
            <label>現在の画像</label>
            <%= image_tag @card.image, class: "current-image-preview" %>
          </div>
        <% end %>

        <div class="field">
          <label>カード画像を変更</label>
          <%= f.file_field :image, accept: "image/*" %>
        </div>

        <%= f.submit "更新する", class: "btn-main" %>
      </div>
    <% end %>

    <%= link_to "← 戻る", cards_path, class: "back-btn" %>
  </div>
</div>