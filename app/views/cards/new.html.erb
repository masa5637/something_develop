<div class="pg">
  <div class="topbar">
    <a href="/" class="topbar-logo">ARCANA</a>
  </div>

  <div class="form-area">
    <div class="lobby-title">カードを作成</div>

    <%= form_with model: @card, local: true do |f| %>
      <div class="card-form">
        <div class="field">
          <label>カード名</label>
          <%= f.text_field :name, placeholder: "例: 炎の番人" %>
        </div>

        <div class="field">
          <label>攻撃力 (ATK)</label>
          <%= f.number_field :attack, placeholder: "0〜100" %>
        </div>

        <div class="field">
          <label>防御力 (DEF)</label>
          <%= f.number_field :defense, placeholder: "0〜100" %>
        </div>

        <div class="field">
          <label>カード画像</label>
          <%= f.file_field :image, accept: "image/*" %>
        </div>

        <%= f.submit "カードを作成", class: "btn-main" %>
      </div>
    <% end %>

    <%= link_to "← 戻る", cards_path, class: "back-btn" %>
  </div>
</div>