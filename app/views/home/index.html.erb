<!-- Hero -->
<div class="hero">
  <div class="hero-bg"></div>
  <div class="hero-deco"></div>
  <% if user_signed_in? %>
    <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn-login" %>
  <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "btn-login" %>
  <% end %>
  <div class="logo">ARCANA</div>
  <div class="logo-sub">Card Battle</div>
  <div class="hero-btns">
    <%= link_to "対戦を始める", lobby_index_path, class: "btn-primary" %>
    <%= link_to "デッキを編集", decks_path, class: "btn-secondary" %>
  </div>
</div>

<!-- カード一覧 -->
<div class="section">
  <div class="section-title">マイカード</div>
  <div class="cards-row">

    <% @cards.each do |card| %>
      <div class="card">
        <div class="card-img">
          <% if card.image.attached? %>
            <%= image_tag card.image, class: "card-img-tag" %>
          <% else %>
            <span class="card-rune">⬡</span>
          <% end %>
        </div>
        <div class="card-body">
          <div class="card-name"><%= card.name %></div>

          <% if card.monster? %>
            <div class="card-stats">
              <div class="stat"><span class="stat-label">ATK</span><span class="stat-val atk"><%= card.attack %></span></div>
              <div class="stat"><span class="stat-label">DEF</span><span class="stat-val def"><%= card.defense %></span></div>
            </div>
          <% else %>
            <div class="card-spell-desc"><%= card.effect_description %></div>
          <% end %>

        </div>
      </div>
    <% end %>

    <%= link_to new_card_path, class: "new-card-btn" do %>
      <div class="plus-icon">+</div>
      カードを追加
    <% end %>
  </div>
</div>