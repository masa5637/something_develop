<body>

  <!-- Hero -->
  <div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-deco"></div>
    <div class="logo">ARCANA</div>
    <div class="logo-sub">Card Battle</div>
    <div class="hero-btns">
      <button class="btn-primary">対戦を始める</button>
      <button class="btn-secondary">デッキを編集</button>
    </div>
  </div>

  <!-- カード一覧 -->
  <div class="section">
    <div class="section-title">マイカード</div>
    <div class="cards-row">

      <div class="card">
        <div class="card-placeholder"><span class="card-rune">⬡</span></div>
        <div class="card-body">
          <div class="card-name">炎の番人</div>
          <div class="card-stats">
            <div class="stat"><span class="stat-label">ATK</span><span class="stat-val atk">72</span></div>
            <div class="stat"><span class="stat-label">DEF</span><span class="stat-val def">35</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-placeholder"><span class="card-rune">◈</span></div>
        <div class="card-body">
          <div class="card-name">氷壁の騎士</div>
          <div class="card-stats">
            <div class="stat"><span class="stat-label">ATK</span><span class="stat-val atk">40</span></div>
            <div class="stat"><span class="stat-label">DEF</span><span class="stat-val def">88</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-placeholder"><span class="card-rune">✦</span></div>
        <div class="card-body">
          <div class="card-name">影の刺客</div>
          <div class="card-stats">
            <div class="stat"><span class="stat-label">ATK</span><span class="stat-val atk">95</span></div>
            <div class="stat"><span class="stat-label">DEF</span><span class="stat-val def">20</span></div>
          </div>
        </div>
      </div>

      <button class="new-card-btn">
        <div class="plus-icon">+</div>
        カードを追加
      </button>

    </div>
  </div>

  <!-- バトルフィールド -->
  <div class="battle-section">
    <div class="section-title">バトルフィールド</div>
    <div class="battle-field">

      <div class="player-area">
        <div class="player-avatar">P2</div>
        <div class="player-info">
          <div class="player-name">相手プレイヤー</div>
          <div class="hp-bar-wrap"><div class="hp-bar low" style="width: 38%"></div></div>
          <div class="hp-num">38 / 100 HP</div>
        </div>
        <div>
          <div class="hand-cards">
            <div class="hand-card-mini">?</div>
            <div class="hand-card-mini">?</div>
            <div class="hand-card-mini">?</div>
          </div>
        </div>
      </div>

      <div class="vs-divider"><span class="vs-text">VS</span></div>

      <div class="player-area">
        <div class="player-avatar">P1</div>
        <div class="player-info">
          <div class="player-name">あなた</div>
          <div class="hp-bar-wrap"><div class="hp-bar" style="width: 80%"></div></div>
          <div class="hp-num">80 / 100 HP</div>
        </div>
        <div>
          <div class="hand-cards">
            <div class="hand-card-mini">⬡</div>
            <div class="hand-card-mini">◈</div>
            <div class="hand-card-mini">✦</div>
          </div>
        </div>
      </div>

      <div class="action-row">
        <button class="action-btn danger">降参</button>
        <button class="action-btn">カードを出す</button>
      </div>

    </div>
  </div>

</body>