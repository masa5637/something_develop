
  <div class="pg">
    <%= link_to "ARCANA", root_path, class: "logo" %>
    <div class="logo-sub">Card Battle</div>

    <div class="form-wrapper">
      <div class="tabs">
        <button class="tab active" id="tab-login" onclick="switchTab('login')">ログイン</button>
        <button class="tab" id="tab-register" onclick="switchTab('register')">新規登録</button>
      </div>

      <div class="card" id="form-card">
        <div class="field">
          <label>メールアドレス</label>
          <input type="email" placeholder="your@email.com" />
        </div>

        <div class="field register-only" id="field-name">
          <label>ユーザー名</label>
          <input type="text" placeholder="召喚師の名前" />
        </div>

        <div class="field">
          <label>パスワード</label>
          <input type="password" placeholder="••••••••" />
        </div>

        <div class="field register-only" id="field-confirm">
          <label>パスワード（確認）</label>
          <input type="password" placeholder="••••••••" />
        </div>

        <button class="btn-main" id="btn-submit">ログイン</button>

        <div class="divider">
          <div class="divider-line"></div>
          <div class="divider-text">OR</div>
          <div class="divider-line"></div>
        </div>

        <button class="btn-guest">ゲストとして入場</button>

        <div class="note" id="bottom-note">
          アカウントをお持ちでない方は<br />「新規登録」へ
        </div>
      </div>
    </div>
  </div>