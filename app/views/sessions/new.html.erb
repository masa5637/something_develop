<div class="auth-wrap">
  <div class="auth-logo">ARCANA</div>
  <div class="auth-logo-sub">Card Battle</div>

  <div class="auth-tabs">
    <a href="/login" class="auth-tab active">ログイン</a>
    <a href="/signup" class="auth-tab">新規登録</a>
  </div>

  <div class="auth-card">
    <%= form_with url: login_path, local: true do |f| %>
      <div class="auth-field">
        <%= f.label :email, "メールアドレス", class: "auth-label" %>
        <%= f.email_field :email, class: "auth-input", placeholder: "arcana@example.com" %>
      </div>
      <div class="auth-field">
        <%= f.label :password, "パスワード", class: "auth-label" %>
        <%= f.password_field :password, class: "auth-input", placeholder: "••••••••" %>
      </div>
      <%= f.submit "ログイン", class: "auth-btn-main" %>
    <% end %>
    <p class="auth-note"><a href="#">パスワードを忘れた方はこちら</a></p>
  </div>
</div>