<div class="pg">
  <a href="/" class="logo">ARCANA</a>
  <div class="logo-sub">Card Battle</div>

  <div class="form-wrapper">
    <div class="tabs">
      <a href="<%= new_user_session_path %>" class="tab">ログイン</a>
      <div class="tab active">新規登録</div>
    </div>

    <div class="card">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <div class="field">
          <label>メールアドレス</label>
          <%= f.email_field :email, placeholder: "your@email.com" %>
        </div>

        <div class="field">
          <label>ユーザー名</label>
          <%= f.text_field :username, placeholder: "召喚師の名前" %>
        </div>

        <div class="field">
          <label>パスワード</label>
          <%= f.password_field :password, placeholder: "••••••••" %>
        </div>

        <div class="field">
          <label>パスワード（確認）</label>
          <%= f.password_field :password_confirmation, placeholder: "••••••••" %>
        </div>

        <%= f.submit "登録して始める", class: "btn-main" %>
      <% end %>

      <div class="divider">
        <div class="divider-line"></div>
        <div class="divider-text">OR</div>
        <div class="divider-line"></div>
      </div>

      <a href="<%= new_user_session_path %>" class="btn-guest">ログインはこちら</a>
    </div>
  </div>
</div>